# Anthropic API key for screenshot extraction (~$0.005 per import).
# Leave blank to use the local `claude` CLI subprocess instead.
# ANTHROPIC_API_KEY=

# Override path to the `claude` CLI binary if auto-detection fails.
# CLAUDE_CLI_PATH=

# Optional Stratz API key. If set, `npm run fetch-data` uses Stratz
# (bracket-filtered matchups, more accurate). Otherwise OpenDota is used.
# Get a key at https://stratz.com/api
# STRATZ_API_KEY=

PLAYER_NAME=Your Name
PLAYER_FRIEND_ID=
PLAYER_MMR=
PLAYER_RANK=legend                  # herald | guardian | crusader | archon | legend | ancient | divine | immortal
PLAYER_PREFERRED_ROLES=2,3          # comma-separated, 1-5

# PORT=3001
